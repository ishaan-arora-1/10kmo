# Copy to .env.local for local development. On Vercel, set these in Project Settings → Environment Variables.
# Leave them empty to run the web app in sample mode.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Set to true after configuring Sign in with Apple for the web (LAUNCH.md step 5b).
VITE_ENABLE_APPLE_SIGN_IN=false
