# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables, then redeploy.
# Leave the Supabase values empty to run the web app in sample mode.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Shown on the paywall. Must match the prices of your Razorpay plans.
VITE_PRICE_YEARLY=$39.99
VITE_PRICE_WEEKLY=$4.99
