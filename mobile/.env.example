# Copy to .env.local for local development. For EAS builds, set these as EAS environment
# variables (eas env:create) so they're baked into the app at build time.
# Use the SAME Supabase project as the website; leave both empty to run in sample mode.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Shown on the paywall. Must match the prices of your Razorpay plans (same as the website).
EXPO_PUBLIC_PRICE_YEARLY=$39.99
EXPO_PUBLIC_PRICE_MONTHLY=$4.99

# The website, for Terms, Privacy, and Support links.
EXPO_PUBLIC_WEBSITE_URL=https://claimrightful.com

# Email reminders need a custom sending domain, so they stay off until one exists (same as the website).
EXPO_PUBLIC_ENABLE_EMAIL_REMINDERS=false
